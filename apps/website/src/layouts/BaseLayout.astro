---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  author?: string;
}

const {
  title,
  description,
  ogType = "website",
  publishedTime,
  author,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#155eef" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Blue" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    {author && <meta name="author" content={author} />}
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
