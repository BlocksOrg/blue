---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  author: string;
}

const { title, description, publishDate, author } = Astro.props;
---

<BaseLayout
  title={`${title} | Blue`}
  description={description}
  ogType="article"
  publishedTime={publishDate}
  author={author}
>
  <SiteHeader current="blog" />

  <main id="main-content" class="blog-post-page">
    <article>
      <header class="blog-post-hero reveal">
        <a class="blog-back-link" href="/blog/"><span aria-hidden="true">←</span> Blog</a>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      <div class="blog-prose">
        <slot />
      </div>
    </article>
  </main>

  <SiteFooter class="blog-footer" />
</BaseLayout>
