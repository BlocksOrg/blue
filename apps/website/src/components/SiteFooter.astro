---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const docsBase = "https://docs.bluee.sh/next";
const github = "https://github.com/BlocksOrg/blue";
const externalLinkProps = { target: "_blank", rel: "noopener noreferrer" };
---

<footer id="footer" class={className}>
  <div class="footer-columns">
    <div class="footer-links">
      <div class="footer-column">
        <h4>Product</h4>
        <ul><li><a href={`${docsBase}/introduction`} {...externalLinkProps}>Overview</a></li><li><a href={`${docsBase}/quickstart`} {...externalLinkProps}>Quickstart</a></li><li><a href={`${docsBase}/concepts/architecture`} {...externalLinkProps}>Architecture</a></li></ul>
      </div>
      <div class="footer-column">
        <h4>Operate</h4>
        <ul><li><a href={`${docsBase}/admin/configuration`} {...externalLinkProps}>Configuration</a></li><li><a href={`${docsBase}/admin/managed-packages`} {...externalLinkProps}>Extensions</a></li><li><a href={`${docsBase}/admin/gateway-access`} {...externalLinkProps}>Bring your own gateway</a></li><li><a href={`${docsBase}/admin/session-capture`} {...externalLinkProps}>Sessions</a></li></ul>
      </div>
      <div class="footer-column">
        <h4>Deploy</h4>
        <ul><li><a href={`${docsBase}/deployment/production`} {...externalLinkProps}>Production</a></li><li><a href={`${docsBase}/development/local-compose`} {...externalLinkProps}>Docker Compose</a></li><li><a href={`${github}/tree/main/deploy/helm`} {...externalLinkProps}>Helm</a></li><li><a href={`${github}/tree/main/deploy/tofu/aws`} {...externalLinkProps}>OpenTofu</a></li></ul>
      </div>
      <div class="footer-column">
        <h4>Project</h4>
        <ul><li><a href="/manifesto/">Why Blue</a></li><li><a href="/blog/">Blog</a></li><li><a href={github} {...externalLinkProps}>GitHub</a></li><li><a href={`${github}/releases`} {...externalLinkProps}>Releases</a></li><li><a href={`${github}/blob/main/CONTRIBUTING.md`} {...externalLinkProps}>Contributing</a></li></ul>
        <h4 class="footer-subheading">Trust</h4>
        <ul><li><a href={`${github}/blob/main/SECURITY.md`} {...externalLinkProps}>Security</a></li><li><a href={`${github}/blob/main/LICENSE`} {...externalLinkProps}>MIT License</a></li></ul>
      </div>
      <div class="footer-column">
        <h4>Connect</h4>
        <ul><li><a href={github} {...externalLinkProps}>GitHub</a></li><li><a href="https://blocks.team" {...externalLinkProps}>Blocks</a></li></ul>
      </div>
    </div>
  </div>
  <div class="footer-copyright"><span>Blue, an open-source project from Blocks.</span></div>
</footer>
