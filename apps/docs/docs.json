{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Blue",
  "description": "Governance and dynamic extension distribution for coding-agent CLIs, with an optional bring-your-own inference gateway and session capture.",
  "colors": {
    "primary": "#1D4ED8",
    "light": "#3B82F6",
    "dark": "#3B82F6"
  },
  "logo": {
    "light": "/images/blue.png",
    "dark": "/images/blue.png"
  },
  "favicon": "/images/favicon.png",
  "redirects": [
    {
      "source": "/next/admin/gateway-and-sessions",
      "destination": "/next/admin/gateway-access"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/BlocksOrg/blue"
      },
      {
        "label": "MIT License",
        "href": "https://github.com/BlocksOrg/blue/blob/main/LICENSE"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/next/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BlocksOrg/blue"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required"
    }
  },
  "navigation": {
    "versions": [
      {
        "version": "Next",
        "groups": [
          { "group": "Start here", "pages": ["next/introduction", "next/quickstart"] },
          { "group": "Deployment", "pages": ["next/deployment/runtime-contract", "next/deployment/production", "next/deployment/blue-yaml", "next/deployment/managed-repositories"] },
          { "group": "Concepts", "pages": ["next/concepts/architecture", "next/concepts/configuration", "next/concepts/harness-version-compatibility", "next/concepts/gateway-mode", "next/concepts/authentication"] },
          { "group": "CLI", "pages": ["next/cli/commands", "next/cli/harnesses", "next/cli/windows-paths", "next/cli/troubleshooting"] },
          { "group": "Administration", "pages": ["next/admin/dashboard", "next/admin/user-management", "next/admin/identity-provisioning", "next/admin/managed-packages", "next/admin/configuration", "next/admin/gateway-access", "next/admin/custom-gateway-provisioners", "next/admin/session-capture"] },
          { "group": "Development", "pages": ["next/development/local-compose", "next/development/contributing", "next/development/harness-adapter-architecture", "next/development/gateway-adapter-architecture"] },
          { "group": "Reference", "pages": ["next/reference/governance-config", "next/reference/auth-endpoints"] },
          {
            "group": "API reference",
            "openapi": {
              "source": "/openapi/next.yaml",
              "directory": "next/api-reference"
            }
          }
        ]
      }
    ]
  }
}
