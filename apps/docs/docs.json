{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Blue",
  "description": "Governance and dynamic extension distribution for coding-agent CLIs, with an optional bring-your-own inference gateway and session capture.",
  "colors": {
    "primary": "#1D4ED8",
    "light": "#3B82F6",
    "dark": "#3B82F6"
  },
  "logo": {
    "light": "/images/blue.png",
    "dark": "/images/blue.png"
  },
  "favicon": "/images/favicon.png",
  "redirects": [
    {
      "source": "/next/admin/gateway-and-sessions",
      "destination": "/next/admin/gateway-access"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/BlocksOrg/blue"
      },
      {
        "label": "Why Blue",
        "href": "https://bluee.sh/manifesto"
      },
      {
        "label": "MIT License",
        "href": "https://github.com/BlocksOrg/blue/blob/main/LICENSE"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/next/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BlocksOrg/blue"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
