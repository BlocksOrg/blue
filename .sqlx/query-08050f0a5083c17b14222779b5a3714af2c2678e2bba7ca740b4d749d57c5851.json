  "query": "select i.id,i.email,i.role,i.status,i.\"expiresAt\" as expires_at,i.\"createdAt\" as created_at,u.email as inviter_email from auth.\"invitation\" i left join auth.\"user\" u on u.id=i.\"inviterId\" where i.\"organizationId\"=$1 and ($2::bool=false or i.status='pending') and ($3::text is null or lower(i.email) like $3 escape E'\\\\') and ($4::text is null or i.role=$4) order by i.\"createdAt\" desc limit $5 offset $6",
