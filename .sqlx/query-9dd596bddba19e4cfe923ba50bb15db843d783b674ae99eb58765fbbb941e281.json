  "query": "select u.id,u.subject,u.email,u.active,s.external_id,s.user_name,s.given_name,s.family_name,s.created_at,s.updated_at from scim_user_resources s join users u on u.id=s.user_id where s.organization_id=$1 and u.status<>'removed' and ($2::text is null or ($2='userName' and lower(s.user_name)=lower($3)) or ($2='externalId' and s.external_id=$3)) order by lower(s.user_name) offset $4 limit $5",
