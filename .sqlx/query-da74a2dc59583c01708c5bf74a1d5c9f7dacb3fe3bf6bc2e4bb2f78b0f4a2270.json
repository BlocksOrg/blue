{
  "db_name": "PostgreSQL",
  "query": "select s.user_id,u.organization_id,least(ga.source_expires_at,ba.\"expiresAt\") as \"gateway_session_expires_at!\",ga.reactivated_at as session_not_before,s.gateway_email,s.source_key_hash,s.source_key_alias,s.proxy_key_alias,s.provisioner_config_hash,s.provisioner_metadata,s.credential_expires_at,s.last_reconciled_at,s.provisioning_error,s.credential_ciphertext,s.credential_nonce,s.credential_wrapped_key,s.encryption_key_id,s.credential_version,s.credential_state,s.invalidated_at,s.invalidation_reason,s.recovery_attempts,s.next_recovery_at,s.recovery_lease_until,s.last_validated_at from public.gateway_key_selections s join users u on u.id=s.user_id join public.gateway_auth_sessions ga on ga.user_id=s.user_id join auth.\"session\" ba on ba.id=ga.oauth_session_id and ba.\"userId\"=u.subject where s.user_id=$1 and ga.oauth_session_id=$2 and ga.revoked_at is null and ga.source_expires_at>now() and ba.\"expiresAt\">now() and u.active=true",
