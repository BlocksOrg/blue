{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["networkPolicy"],
  "properties": {
    "networkPolicy": {
      "type": "object",
      "required": ["databaseCidrs", "databasePort", "dns"],
      "properties": {
        "databaseCidrs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]+$" }
        },
        "databasePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dns": {
          "type": "object",
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        }
      }
    }
  }
}
